<:: hidden
kind: kit;

.. ---------- the home page: four blocks of colour ---------- ..
$site <:
    %cream: #FBF6EC;
    fill: ink;
    font: PMC Header, impact, sans-serif;
    caps: yes;
    height: screen;
    clip: yes;
:>
$d <:
    font: PMC Header, impact, sans-serif;
    caps: yes;
    weight: 400;
:>
$tx <:
    font: PMC Font Upright, PMC Font, courier new, monospace;
    caps: no;
:>
$panels <:
    pin: fill;
    layout: row;
    | phone <:
        layout: stack;
        pin: top 44;
    :>
:>

.. a block opens when it holds the link to the page you are on ..
$panel <:
    stretch: 1;
    clip: yes;
    cursor: hand;
    fill: %bg;
    colour: %fg;
    ease: 0.9 snappy;
    steps <:
        start <: see-through: 100%;; move: 0, 36; :>
    :>
    *hover <: stretch: 1.3; :>
    *here <:
        stretch: 6;
        cursor: normal;
        $dots <: see-through: 0;; ease: 0.6 wait 0.35; :>
        $side <: see-through: 100%;; hide: yes;; touch: no; :>
        $body <: hide: no;; see-through: 0;; ease: 0.5 wait 0.3; :>
        $in <: play: 0.9 smooth; :>
    :>
    | phone <:
        *here <: stretch: 12; :>
    :>
:>
$me <:
    %fg: ink;
    %bg: %cream;
    %sh: deep-green;
    colour: %fg;
    $dots <: colour: green; :>
    $dotset <: see-through: 58%; :>
    $side <: text: across; :>
:>
$ab <:
    %fg: %cream;
    %bg: deep-green;
    %sh: ink;
    border: left 4 ink;
    $dots <: colour: %cream; :>
    $dotset <: see-through: 70%; :>
    | phone <: border: left 0, top 4 ink; :>
:>
$ap <:
    %fg: %cream;
    %bg: ink;
    %sh: deep-green;
    border: left 4 ink;
    $dots <: colour: green; :>
    $dotset <: see-through: 30%; :>
    | phone <: border: left 0, top 4 ink; :>
:>
$pj <:
    %fg: ink;
    %bg: gold;
    %sh: ink;
    border: left 4 ink;
    $dots <: colour: ink; :>
    $dotset <: see-through: 70%; :>
    | phone <: border: left 0, top 4 ink; :>
:>

.. comic-book halftone, three sizes of dot fading out from the corner ..
$dots <:
    over: top 0, right 0;
    width: least 46 wide, 540;
    ratio: 1;
    see-through: 100%;
    touch: no;
    ease: 0.4;
    | phone <: width: 80 wide; :>
:>
$dotset <:
    over: fill;
:>
$dot1 <:
    over: fill;
    dots: current 3.9 13;
    fade: top-right 8 32;
:>
$dot2 <:
    over: fill;
    dots: current 2.7 13;
    fade: top-right 8 24 50;
:>
$dot3 <:
    over: fill;
    dots: current 1.5 13;
    fade: top-right 24 42 70;
:>

.. closed: the name (or the logo) stands up the side ..
$side <:
    over: left 0, bottom 0;
    text: up;
    pad: 18 to 32 at 2 wide;
    size: 54.4 to 128 at 7.6 wide;
    line: 0.9;
    wrap: no;
    underline: no;
    ease: 0.3;
    | phone <:
        text: across;
        over: top 0, left 0;
        height: fill;
        layout: row;
        y: centre;
        pad: 0, 18;
        size: 38.4 to 64 at 13 wide;
    :>
:>
$logoup <:
    layout: block;
    width: 64 to 116 at 7.4 wide;
    | phone <: show: no; :>
:>
$logoacross <:
    show: no;
    | phone <:
        layout: block;
        height: 30 to 48 at 7 tall;
        width: auto;
    :>
:>

.. open: the full piece. A fixed width, so the text never reflows while the block grows ..
$body <:
    over: top 0, left 0, bottom 0;
    width: 66.66 wide;
    pad: top 64 to 92 at 8 tall, right 40 to 76 at 5 wide, bottom 22 to 44 at 2.6 wide, left 22 to 44 at 2.6 wide;
    layout: stack;
    y: between;
    gap: 20;
    scroll: y;
    scrollbar: none;
    hide: yes;
    see-through: 100%;
    ease: 0.25;
    | phone <:
        width: fill;
        pad: top 56, right 18, bottom 18, left 18;
        y: start;
        gap: 16;
    :>
:>
$in <:
    stagger: 0.09 after 0.35;
:>
$ht <:
    size: least 10.8 wide, 24 tall;
    line: 0.82;
    weight: 400;
    stretch: no;
    | phone <: show: no; :>
:>
$tallonly <:
    | short <: show: no; :>
:>

.. home ..
$logo <:
    layout: block;
    width: least 78%, 78.1 tall;
    | phone <: width: least 78%, 42.6 tall; :>
:>
$big <:
    size: least 7.2 wide, 12.5 tall;
    line: 0.92;
    widest: 16 letters;
    | phone <:
        size: least 11 wide, 8 tall;
        widest: none;
    :>
:>
$intro <:
    size: 16 to 22.4 at 1.4 wide;
    line: 1.6;
    space: top 16;
    widest: 36 letters;
:>

.. about ..
$cols <:
    columns: fill 1.15, fill 1;
    gap: 20 to 48 at 3 wide;
    y: start;
    | phone <:
        columns: 1;
        gap: 34;
    :>
:>
$lead <:
    size: 28.8 to 89.6 at 4.6 wide;
    line: 0.95;
    | phone <: size: 32; :>
:>
$colstx <:
    size: 15.7 to 33.6 at 1.75 wide;
    line: 1.5;
:>
$gap18 <:
    space: top 18;
:>
$partner <:
    space: top 22;
:>
$partnerlink <:
    underline: no;
    border: bottom 3 current;
    ease: 0.1;
    *hover <:
        fill: %fg;
        colour: %bg;
    :>
:>
$lab <:
    size: 20.8 to 35.2 at 1.9 wide;
    space: bottom 10;
    see-through: 30%;
:>
$now <:
    pad: 10 to 18 at 1.2 wide, 0;
    border: top 2 current;
    size: 14.7 to 30.4 at 1.6 wide;
    line: 1.4;
:>
$chips <:
    layout: wrap;
    gap: 8;
    space: top 16;
:>
$chip <:
    border: 2 current;
    size: 17.6;
    line: 1;
    shadow: 4 %sh;
    underline: no;
    ease: 0.1 smooth;
    *hover <:
        lift: 2;
        shadow: 7 %sh;
        fill: %fg;
        colour: %bg;
    :>
    *press <:
        sink: 1;
        shadow: 2 %sh;
        ease: 0.04;
    :>
:>
$linkchip <:
    layout: block;
    size: 17.6 to 30.4 at 1.6 wide;
    pad: 6 to 10.6 at 0.56 wide, 12 to 21.3 at 1.12 wide;
:>

.. apps ..
$grp <:
    $lab <: space: bottom 12; :>
:>
$grp2 <:
    space: top 18 to 30 at 3 tall;
:>
$tiles <:
    columns: 4;
    gap: 12 to 22 at 1.5 wide;
    | phone <:
        columns: 1;
        gap: 10;
    :>
:>
$two <:
    columns: 2;
:>
$three <:
    columns: 3;
    | phone <: columns: 1; :>
:>
$tile <:
    layout: stack;
    height: fill;
    border: 3 current;
    fill: %bg;
    shadow: 7 %sh;
    underline: no;
    ease: 0.1 smooth;
    *hover <:
        lift: 2;
        shadow: 11 %sh;
    :>
    *press <:
        sink: 1;
        shadow: 2 %sh;
        ease: 0.04;
    :>
    | phone <:
        layout: row;
        shadow: 5 %sh;
    :>
:>
$th <:
    layout: block;
    ratio: 16/10;
    border: bottom 3 current;
    clip: yes;
    fill: %fg;
    | phone <:
        width: 88;
        stretch: no;
        ratio: none;
        border: bottom 0, right 3 current;
    :>
:>
$fillimg <:
    layout: block;
    width: fill;
    height: fill;
    fit: cover;
:>
$thumb <:
    fit: cover top;
:>
$tt <:
    layout: stack;
    gap: 4;
    pad: top 10, x 12, bottom 12;
    | phone <:
        y: centre;
        narrowest: 0;
        pad: 8, 12;
    :>
:>
$tilename <:
    size: 22.4 to 32 at 1.9 wide;
    line: 0.95;
    | phone <: size: 22.4; :>
:>
$tilesay <:
    size: 12.8 to 14.7 at 0.9 wide;
    line: 1.35;
    see-through: 15%;
    | phone <: lines: 2; :>
:>
$apptile <:
    layout: row;
    y: centre;
    gap: 14 to 26 at 1.6 wide;
    pad: 10 to 26 at least 1.5 wide 1.9 tall, 14 to 30 at 1.7 wide;
    shadow: 5 %sh;
:>
$applogo <:
    layout: block;
    width: 48 to 110 at least 6.4 wide 9 tall;
    stretch: no;
    ratio: 1;
    $fillimg <: fit: whole; :>
:>
$apptt <:
    pad: 0;
    narrowest: 0;
:>
$appname <:
    size: 20.8 to 44.8 at least 2.3 wide 3.7 tall;
:>
$appsay <:
    size: 12.5 to 24 at least 1.25 wide 2 tall;
    lines: none;
:>
$plates <:
    layout: stack;
    gap: 14 to 22 at 2 tall;
    width: least 100%, 640;
:>
$plate <:
    columns: 72 to 110 at least 6.4 wide 11 tall, fill 1;
    gap: 14 to 22 at 1.6 wide;
    y: centre;
    pad: 10 to 18 at least 1.1 wide 1.5 tall, 14 to 22 at 1.4 wide;
    border: 3 current;
    shadow: 6 %sh;
    | phone <: y: start; :>
:>
$pic <:
    layout: block;
    border: 3 current;
    shadow: 4 green;
    clip: yes;
    ratio: 1;
:>
$platename <:
    size: 25.6 to 44.8 at least 2.3 wide 3.7 tall;
    line: 0.9;
    weight: 400;
:>
$platesay <:
    size: 13.6 to 22.4 at least 1.15 wide 1.9 tall;
    line: 1.5;
    space: top 6, bottom 10;
    widest: 46 letters;
:>
$cta <:
    layout: inline;
    pad: 8 to 14 at 0.8 wide, 14 to 26 at 1.4 wide;
    fill: %fg;
    colour: %bg;
    size: 18.4 to 32 at 1.6 wide;
    line: 1;
    letters: 0.03;
    underline: no;
    ease: 0.1;
    *hover <:
        fill: green;
        colour: %cream;
        lift: 2;
    :>
    *press <: sink: 1; :>
:>

.. projects ..
$note <:
    size: 13.8 to 16 at 1 wide;
    line: 1.5;
    see-through: 15%;
    space: top 14;
    widest: 52 letters;
:>

.. the bar in the top right: YouTube and PMC ID ..
$out <:
    pin: top 0, right 0;
    front: 10;
    layout: row;
    | phone <:
        pin: top 0, left 0, right 0;
        height: 44;
    :>
:>
$outlink <:
    pad: 14, 16 to 26 at 1.8 wide;
    fill: ink;
    colour: %cream;
    size: 22.4;
    letters: 0.04;
    line: 1;
    underline: no;
    ease: 0.1;
    *hover <:
        fill: gold;
        colour: ink;
    :>
    | phone <:
        stretch: yes;
        layout: row;
        x: centre;
        y: centre;
        pad: 0;
        size: 20.8;
    :>
:>
$account <:
    width: 56;
    layout: centre;
    fill: ink;
    colour: %cream;
    border: left 3 %cream;
    ease: 0.14 smooth;
    *hover <:
        fill: gold;
        colour: ink;
        lift: 2;
    :>
    *press <:
        sink: 1;
        ease: 0.04;
    :>
    | phone <: stretch: no; :>
:>
$usericon <:
    width: 24;
    height: 24;
:>

.. ---------- the school website pages ---------- ..
$case <:
    %cream: #FBF6EC;
    fill: %cream;
    colour: ink;
    font: PMC Font Upright, PMC Font, courier new, monospace;
    size: 16.8;
    line: 1.65;
:>
$green <:
    %bg: deep-green;
    %fg: %cream;
:>
$black <:
    %bg: ink;
    %fg: %cream;
:>
$gold <:
    %bg: gold;
    %fg: ink;
:>
$bar <:
    pin: top 0, left 0, right 0;
    front: 20;
    height: 56;
    layout: row;
    x: between;
    fill: ink;
    colour: %cream;
:>
$mark <:
    layout: row;
    y: centre;
    pad: 0, 22;
:>
$marklogo <:
    width: 57;
    height: 32;
:>
$barright <:
    layout: row;
:>
$back <:
    layout: row;
    y: centre;
    pad: 0, 24;
    border: left 3 %cream;
    size: 22.4;
    letters: 0.04;
    underline: no;
    ease: 0.1;
    *hover <:
        fill: gold;
        colour: ink;
    :>
:>
$hero <:
    space: top 56;
    pad: top 36 to 90 at 8 tall, x 22 to 64 at 4 wide, bottom 34 to 70 at 6 tall;
    fill: %bg;
    colour: %fg;
    clip: yes;
:>
$kicker <:
    size: 16;
    see-through: 15%;
:>
$herotitle <:
    size: least 17 wide, 30 tall;
    line: 0.82;
    space: top 14, bottom 26;
    play: 0.8 in;
    steps <:
        start <: see-through: 100%;; move: 0, -40; :>
    :>
    | phone <: size: 19 wide; :>
:>
$sum <:
    size: 18.4 to 27.2 at 1.9 wide;
    line: 1.45;
    widest: 30 letters;
:>
$herorow <:
    layout: wrap;
    gap: 28, 56;
    y: end;
    space: top 32;
:>
$visit <:
    layout: inline;
    pad: 16, 26;
    fill: ink;
    colour: %cream;
    size: 27.2;
    line: 1;
    letters: 0.03;
    underline: no;
    ease: 0.1;
    *hover <:
        fill: green;
        colour: %cream;
    :>
    *press <: move: 0, 4; :>
:>
$herovisit <:
    fill: %fg;
    colour: %bg;
:>
$meta <:
    layout: wrap;
    gap: 14, 40;
:>
$dt <:
    size: 17.6;
    see-through: 30%;
:>
$dd <:
    size: 15.2;
    line: 1.45;
    widest: 26 letters;
:>

.. screenshots: click one to see it big ..
$shot <:
    pad: top 24 to 60 at 4 wide, x 22 to 64 at 4 wide;
:>
$frame <:
    border: 4 ink;
    shadow: 14 deep-green;
    fill: paper;
    cursor: hand;
    ease: 0.1;
    *hover <:
        lift: 4;
        shadow: 18 deep-green;
    :>
    | phone <: shadow: 8 deep-green; :>
:>
$shotimg <:
    layout: block;
    width: fill;
:>
$caption <:
    space: top 22, bottom 4;
    size: 15.2;
    widest: 62 letters;
    see-through: 15%;
:>
$duo <:
    columns: 2;
    border: top 4 ink;
    pad: bottom 40 to 90 at 7 wide;
    $shot <: pad: top 36 to 64 at 5 wide; :>
    | phone <: columns: 1; :>
:>

.. the story sections ..
$story <:
    columns: fill 5, fill 6;
    gap: 24 to 80 at 4 wide;
    pad: y 48 to 110 at 9 tall, x 22 to 64 at 4 wide;
    border: top 4 ink;
    space: top 40 to 90 at 7 wide;
    | phone <: columns: 1; :>
:>
$storyend <:
    layout: grid;
    y: end;
:>
$storyhead <:
    size: 35.2 to 80 at 5 wide;
    line: 0.92;
:>
$storysay <:
    size: 16.8 to 21.6 at 1.4 wide;
    line: 1.65;
:>
$plates2 <:
    columns: fit 300;
    gap: 20 to 36 at 2.4 wide;
    pad: x 22 to 64 at 4 wide, bottom 36 to 70 at 6 tall;
:>
$plate2 <:
    border: 3 ink;
    shadow: 9 deep-green;
    pad: 18 to 28 at 2 wide;
    fill: %cream;
:>
$platehead <:
    size: 27.2 to 38.4 at 2.3 wide;
    line: 0.95;
    space: bottom 12;
:>
$platetext <:
    size: 16;
    line: 1.6;
:>
$notes <:
    pad: x 22 to 64 at 4 wide, bottom 36 to 70 at 6 tall;
:>
$fnline <:
    border: top 2 ink;
    pad: top 4;
:>
$fn <:
    size: 15.2;
    line: 1.55;
    widest: 70 letters;
    pad: top 10;
:>
$decision <:
    pad: y 22;
    border: top 3 ink;
    *first <:
        border: none;
        pad: top 0;
    :>
:>

.. works on a phone too ..
$phonesection <:
    columns: fill 6, fill 5;
    gap: 30 to 90 at 5 wide;
    y: centre;
    pad: y 48 to 110 at 9 tall, x 22 to 64 at 4 wide;
    border: top 4 ink;
    | phone <: columns: 1; :>
:>
$pstext <:
    size: 16.8 to 21.6 at 1.4 wide;
    line: 1.65;
    space: top 22, bottom 30;
    widest: 34 letters;
:>
$device <:
    layout: stack;
    x: centre;
    | phone <: x: start; :>
:>
$deviceframe <:
    width: least 320, 78 wide;
    border: top 34 ink, left 10 ink, right 10 ink, bottom 22 ink;
    fill: paper;
    shadow: 12 deep-green;
    cursor: hand;
    ease: 0.1;
    *hover <:
        lift: 4;
        shadow: 16 deep-green;
    :>
:>
$notch <:
    over: top -21, left 50%;
    width: 56;
    height: 6;
    space: left -28;
    fill: %cream;
:>

.. next project and the footer ..
$next <:
    layout: stack;
    gap: 6;
    pad: y 44 to 110 at 9 tall, x 22 to 64 at 4 wide;
    fill: %bg;
    colour: %fg;
    border: top 4 ink;
    underline: no;
    ease: 0.3;
    *hover <: pad: left 36 to 96 at 6 wide; :>
:>
$nextsay <:
    size: 16;
    see-through: 15%;
:>
$nextname <:
    size: least 15 wide, 26 tall;
    line: 0.85;
    | phone <: size: 17 wide; :>
:>
$foot <:
    layout: row;
    x: between;
    gap: 20;
    pad: 22, 22 to 64 at 4 wide;
    fill: ink;
    colour: %cream;
    size: 20.8;
    | phone <: size: 17.6; :>
:>
$footlink <:
    underline: no;
    *hover <: colour: gold; :>
:>

.. comes in as you scroll down ..
$rv <:
    see-through: 100%;
    move: 0, 34;
    ease: 0.8 smooth;
    *seen <:
        see-through: 0;
        move: 0, 0;
    :>
    | still <: move: 0, 0; :>
:>

.. the big picture ..
$lb <:
    pin: fill;
    front: 50;
    fill: ink 96%;
    scroll: y;
    pad: top 64, x 10 to 40 at 3 wide, bottom 30;
:>
$lbimg <:
    layout: block;
    width: auto;
    widest: least 1500, 100%;
    centre: yes;
:>
$lbx <:
    pin: top 0, right 0;
    pad: 14, 22;
    fill: %cream;
    colour: ink;
    border: none;
    size: 24;
:>

.. ---------- the page that isn't there ---------- ..
$lost <:
    %cream: #FBF6EC;
    fill: %cream;
    colour: ink;
    font: PMC Header, impact, sans-serif;
    caps: yes;
    height: screen;
    clip: yes;
:>
$stage <:
    pin: fill;
    layout: stack;
    y: between;
    pad: 18 to 48 at 3 wide;
    scroll: y;
    scrollbar: none;
    play: 1.45 linear;
    steps <:
        39.31 <: move: 0, 0; :>
        43.1 <: move: 0, 0; :>
        43.17 <: move: -9, 9; :>
        46.97 <: move: -9, 9; :>
        47.03 <: move: 9, -9; :>
        50.83 <: move: 9, -9; :>
        50.9 <: move: -5.4, 7.2; :>
        54.69 <: move: -5.4, 7.2; :>
        54.76 <: move: 3.6, -3.6; :>
        58.55 <: move: 3.6, -3.6; :>
        58.62 <: move: 0, 0; :>
        60.0 <: move: 0, 0; :>
        63.79 <: move: 0, 0; :>
        63.86 <: move: -14, 14; :>
        67.66 <: move: -14, 14; :>
        67.72 <: move: 14, -14; :>
        71.52 <: move: 14, -14; :>
        71.59 <: move: -8.4, 11.2; :>
        75.38 <: move: -8.4, 11.2; :>
        75.45 <: move: 5.6, -5.6; :>
        79.24 <: move: 5.6, -5.6; :>
        79.31 <: move: 0, 0; :>
        80.69 <: move: 0, 0; :>
        84.48 <: move: 0, 0; :>
        84.55 <: move: -9, 9; :>
        88.34 <: move: -9, 9; :>
        88.41 <: move: 9, -9; :>
        92.21 <: move: 9, -9; :>
        92.28 <: move: -5.4, 7.2; :>
        96.07 <: move: -5.4, 7.2; :>
        96.14 <: move: 3.6, -3.6; :>
        99.93 <: move: 3.6, -3.6; :>
        100.0 <: move: 0, 0; :>
    :>
:>
$top <:
    layout: row;
    x: between;
    y: centre;
:>
$toplogo <:
    width: 71;
    height: 40;
:>
$topright <:
    layout: row;
    y: centre;
    gap: 16;
:>
$toperror <:
    size: 17.6;
:>
$lostaccount <:
    width: 44;
    height: 44;
    layout: centre;
    border: 3 ink;
    fill: %cream;
    colour: ink;
    ease: 0.14 smooth;
    *hover <:
        fill: ink;
        colour: %cream;
        lift: 2;
    :>
    *press <: sink: 1; :>
:>
$digits <:
    layout: row;
    x: centre;
    gap: 8 to 32 at 2 wide;
    size: least 30 wide, 52 tall;
    line: 0.8;
    | phone <: size: 34 wide; :>
:>
$digit <:
    shadow: text 4.5% deep-green;
    stagger: 0.3 after 0.15;
    play: 0.42 in;
    steps <:
        start <: move: 0, -130%; :>
    :>
:>
$bot <:
    layout: wrap;
    x: between;
    y: end;
    gap: 20, 40;
    | phone <:
        layout: stack;
        x: start;
        gap: 18;
    :>
:>
$msg <:
    size: 32 to 73.6 at 5 wide;
    line: 0.95;
    widest: 12 letters;
    | phone <: size: 43.2; :>
:>
$msgsay <:
    space: top 12;
    size: 15.2 to 19.2 at 1.2 wide;
    line: 1.55;
    widest: 38 letters;
:>
$btn <:
    layout: inline;
    pad: 18, 30;
    fill: ink;
    colour: %cream;
    size: 27.2 to 41.6 at 2.6 wide;
    line: 1;
    letters: 0.03;
    shadow: 8 deep-green;
    underline: no;
    ease: 0.1;
    *hover <:
        fill: green;
        lift: 4;
        shadow: 12 deep-green;
    :>
    *press <:
        sink: 6;
        shadow: 2 deep-green;
        ease: 0.04;
    :>
    | phone <:
        size: 30.4;
        pad: 14, 22;
    :>
:>
::>
